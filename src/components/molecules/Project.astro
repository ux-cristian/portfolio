---
import { Image } from "astro:assets";
import Tag from "../atoms/Tag.astro";
import Icon from "../atoms/Icon.astro";
import RichText from "../atoms/RichText.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";
import type { Project } from "../../lib/projects";

interface Props {
  project: Project;
  lang: Lang;
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const t = useTranslations(lang);
const { title, category, description, cover, client, results } = project.data;
const highlight = results?.find((result) => result.metric);
const href = localizePath(`/project/${project.slug}/`, lang);
---

<!-- Toda la tarjeta es clicable gracias al ::after del enlace del título -->
<article
  data-reveal
  class:list={[
    "group glass relative rounded-[2rem] p-2 transition-all duration-500 ease-[var(--ease-out-expo)]",
    "hover:-translate-y-1 hover:shadow-[0_30px_80px_-30px_rgb(0_0_0/0.6)]",
    "has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-accent",
  ]}
>
  <div class:list={["grid h-full", featured && "lg:grid-cols-[1.3fr_1fr]"]}>
    <div
      class:list={["relative overflow-hidden rounded-[1.6rem] bg-ink-950/50", featured ? "aspect-[16/10] lg:aspect-auto lg:min-h-[26rem]" : "aspect-[16/10]"]}
      transition:name={`cover-${project.slug}`}
    >
      <Image
        src={cover}
        alt={`${t.projects.coverAlt} ${title}`}
        widths={[640, 960, 1280, 1920]}
        sizes={featured ? "(min-width: 1024px) 640px, 100vw" : "(min-width: 768px) 560px, 100vw"}
        class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950/40 to-transparent"></div>
    </div>

    <div class="flex flex-col gap-4 p-5 md:p-7">
      <div class="flex flex-wrap items-center gap-2">
        <Tag variant="accent">{category}</Tag>
        <span class="text-xs font-medium text-subtle">{client}</span>
      </div>
      <h3 class="text-2xl font-bold tracking-tight text-balance md:text-3xl">
        <a href={href} class="after:absolute after:inset-0 after:rounded-[2rem] focus-visible:outline-none">
          {title}
        </a>
      </h3>
      <p class="text-pretty text-muted">{description}</p>

      {highlight && (
        <div class="flex items-center gap-4 rounded-2xl border border-line bg-accent-soft px-4 py-3">
          <span class="shrink-0 text-2xl font-bold tracking-tight text-accent">{highlight.metric}</span>
          <RichText content={highlight.description} class="line-clamp-2 text-sm leading-snug! text-muted" />
        </div>
      )}

      <span aria-hidden="true" class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-semibold text-accent">
        {t.projects.view}
        <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </span>
    </div>
  </div>
</article>
