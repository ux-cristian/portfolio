---
import Icon from "../atoms/Icon.astro";

interface Props {
  title: string;
  company: string;
  url: string;
  period: string;
  description: string;
  newTabLabel: string;
}

const { title, company, url, period, description, newTabLabel } = Astro.props;
---

<li class="relative grid gap-1 border-l border-line pb-8 pl-6 last:pb-0">
  <span class="absolute top-1.5 -left-[5px] size-2.5 rounded-full bg-accent ring-4 ring-accent-soft" aria-hidden="true"></span>
  <span class="text-xs font-semibold tracking-wide text-subtle uppercase">{period}</span>
  <h4 class="font-bold">
    {title} ·
    <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-accent hover:underline">
      {company}<Icon name="arrow-up-right" class="size-3.5" /><span class="sr-only">{newTabLabel}</span>
    </a>
  </h4>
  <p class="text-sm leading-relaxed text-muted">{description}</p>
</li>
