---
interface Props {
  icon: (props: astroHTML.JSX.SVGAttributes) => any;
  class?: string;
}

const { icon: Icon, class: className } = Astro.props;
---

<div class:list={["flex w-full items-center gap-3.5 md:gap-5 xl:gap-6", className]}>
  <Icon class="size-7 md:size-9 xl:size-12 fill-gray-800 shrink-0" aria-hidden="true" />
  <h2 class="font-brand font-semibold w-full text-3xl md:text-4xl xl:text-5xl text-gray-800">
    <slot />
  </h2>
</div>
