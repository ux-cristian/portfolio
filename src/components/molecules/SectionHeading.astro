---
import Tag from "../atoms/Tag.astro";

interface Props {
  eyebrow?: string;
  lead?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
  class?: string;
}

const { eyebrow, lead, align = "left", as: Heading = "h2", class: className } = Astro.props;
---

<div
  data-reveal
  class:list={[
    "flex max-w-3xl flex-col gap-4",
    align === "center" ? "mx-auto items-center text-center" : "items-start",
    className,
  ]}
>
  {eyebrow && <Tag variant="accent">{eyebrow}</Tag>}
  <Heading class="font-display text-3xl font-semibold tracking-tight text-balance md:text-5xl md:leading-[1.08]">
    <slot />
  </Heading>
  {lead && <p class="text-lg text-pretty text-muted md:text-xl">{lead}</p>}
</div>
