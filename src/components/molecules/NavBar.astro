---
import Button from "../atoms/Button.astro";
import ThemeToggle from "../atoms/ThemeToggle.astro";
import Logo from "../atoms/Logo.astro";
import { localizePath, stripLang, useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath("/", lang);
const otherLang: Lang = lang === "es" ? "en" : "es";
const switchHref = localizePath(stripLang(Astro.url.pathname), otherLang);

const links = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#about`, label: t.nav.about },
];
---

<nav
  id="main-nav"
  aria-label={t.a11y.mainNav}
  class="group relative isolate flex h-16 items-center justify-between gap-4 pr-2 pl-5 md:pl-6"
>
  <!-- Fondo glass en una capa aparte: así el menú móvil (hermano, no hijo) también puede difuminar -->
  <div class="glass absolute inset-0 -z-10 rounded-full transition-[background,box-shadow] duration-500 group-data-scrolled/header:glass-strong" aria-hidden="true"></div>

  <a href={home} aria-label={t.a11y.home} class="text-fg transition-opacity hover:opacity-80">
    <Logo />
  </a>

  <ul
    id="main-menu"
    class="flex transition-all duration-300
      max-lg:glass-strong max-lg:invisible max-lg:absolute max-lg:inset-x-0 max-lg:top-[calc(100%+0.75rem)] max-lg:flex-col max-lg:gap-1 max-lg:rounded-3xl max-lg:p-3 max-lg:opacity-0 max-lg:translate-y-2
      max-lg:group-data-open:visible max-lg:group-data-open:translate-y-0 max-lg:group-data-open:opacity-100"
  >
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class="block rounded-full px-4 py-3 text-sm font-medium text-muted transition-colors hover:bg-white/10 hover:text-fg lg:py-2">
          {label}
        </a>
      </li>
    ))}
    <li class="sm:hidden">
      <a href={`${home}#contact`} class="block rounded-full px-4 py-3 text-sm font-semibold text-accent">{t.nav.cta}</a>
    </li>
  </ul>

  <div class="flex items-center gap-1">
    <a
      href={switchHref}
      hreflang={otherLang}
      lang={otherLang}
      aria-label={t.nav.switchLangLabel}
      title={t.nav.switchLangLabel}
      class="flex h-10 items-center rounded-full px-3 text-xs font-bold tracking-wider text-muted uppercase transition-colors hover:bg-white/10 hover:text-fg"
    >
      {otherLang}
    </a>
    <ThemeToggle label={t.a11y.toggleTheme} />
    <div class="ml-1 hidden sm:block">
      <Button href={`${home}#contact`}>{t.nav.cta}</Button>
    </div>
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label={t.a11y.openMenu}
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
      class="flex size-10 flex-col items-center justify-center gap-1.5 rounded-full transition-colors hover:bg-white/10 lg:hidden
        group-data-open:[&>span:nth-child(1)]:translate-y-[4px] group-data-open:[&>span:nth-child(1)]:rotate-45
        group-data-open:[&>span:nth-child(2)]:-translate-y-[4px] group-data-open:[&>span:nth-child(2)]:-rotate-45"
    >
      <span class="block h-0.5 w-5 rounded-full bg-fg transition-transform duration-300"></span>
      <span class="block h-0.5 w-5 rounded-full bg-fg transition-transform duration-300"></span>
    </button>
  </div>
</nav>
