---
import Tag from '../atoms/Tag.astro';

const skills = [
    "Design thinking",
    "Investigación de usuarios",
    "Empatía",
    "Flujos de usuario",
    "Wireframes",
    "Prototipado",
    "Colaboración",
    "Sistemas de diseño",
    "UI Kits",
];
---

<ul aria-label="Habilidades" class="flex flex-wrap gap-2 md:gap-3">
    {skills.map((skill) => <li class="flex"><Tag size="xs">{skill}</Tag></li>)}
</ul>
