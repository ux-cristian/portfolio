---
import Container from "../../templates/Container.astro";
import Tag from '../atoms/Tag.astro';

const skills = [
    "Design thinking",
    "Investigación de usuarios",
    "Empatía",
    "Flujos de usuario",
    "Wireframes",
    "Prototipado",
    "Colaboración",
    "Sistemas de diseño",
    "UI Kits",
];
---

<section aria-label="Habilidades" class="bg-primary-200 pb-16 md:pb-24 xl:pb-28">
    <Container>
        <ul class="flex flex-wrap gap-x-2 gap-y-3 md:gap-x-3 md:gap-y-4 xl:gap-x-4 xl:gap-y-6">
            {skills.map((skill) => <li class="flex"><Tag>{skill}</Tag></li>)}
        </ul>
    </Container>
</section>
