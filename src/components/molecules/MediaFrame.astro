---
// Marco "glass" común para todas las imágenes y vídeos de proyectos,
// para que se vean de la misma familia aunque vengan de fuentes distintas.
interface Props {
  class?: string;
  innerClass?: string;
}

const { class: className, innerClass } = Astro.props;
---

<div class:list={["glass rounded-[1.75rem] p-1.5 md:p-2", className]}>
  <div class:list={["overflow-hidden rounded-[1.35rem] bg-royal-950/50", innerClass]}>
    <slot />
  </div>
</div>
