---
import { Image } from "astro:assets";
import RichText from "../atoms/RichText.astro";
import MediaFrame from "./MediaFrame.astro";
import type { Project } from "../../lib/projects";

interface Props {
  step: Project["data"]["process"][number];
  index: number;
}

const { step, index } = Astro.props;
const { media } = step;
const mediaClass = "block h-auto w-full";
---

<article class="flex flex-col gap-6 md:gap-8">
  <div data-reveal>
    <MediaFrame>
      {media.type === "image" && (
        <Image src={media.src} alt={step.title} widths={[800, 1600, 2400]} sizes="(min-width: 1152px) 1100px, 100vw" class={mediaClass} />
      )}
      {media.type === "gif" && (
        <img src={media.src} alt={step.title} loading="lazy" decoding="async" class={mediaClass} />
      )}
      {media.type === "video" && (
        <video autoplay muted loop playsinline preload="metadata" aria-label={step.title} class={mediaClass}>
          <source src={media.src} type="video/mp4" />
        </video>
      )}
    </MediaFrame>
  </div>

  <div data-reveal class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-10">
    <div class="flex items-baseline gap-3">
      <span class="font-mono text-sm text-accent">{String(index + 1).padStart(2, "0")}</span>
      <h3 class="text-xl font-bold tracking-tight md:text-2xl">{step.title}</h3>
    </div>
    <RichText content={step.description} class="text-muted md:text-lg" />
  </div>
</article>
