---
import Section from "../../templates/Section.astro";
import IconButton from "../atoms/IconButton.astro";

import BehanceIcon from "../../assets/behance.svg";
import LinkedinIcon from "../../assets/linkedin.svg";
import EmailIcon from "../../assets/email.svg";
import LogoIcon from "../../assets/logo_footer.svg";

const iconClass = "fill-primary-50 md:w-7 md:h-7 xl:w-9 xl:h-9";
---

<Section as="footer" class="bg-primary-600">
  <div class="flex w-full flex-col gap-3 xl:gap-6">
    <a href="/" aria-label="Cristian Narváez, ir al inicio" class="mx-auto my-4">
      <LogoIcon class="h-12 xl:h-16 fill-primary-50" aria-hidden="true"/>
    </a>
    <div class="flex w-full justify-center gap-4">
      <IconButton href="https://www.behance.net/cristianarvez" target="_blank" label="Behance"><BehanceIcon class={iconClass} aria-hidden="true"/></IconButton>
      <IconButton href="https://www.linkedin.com/in/ux-cristian/" target="_blank" label="LinkedIn"><LinkedinIcon class={iconClass} aria-hidden="true"/></IconButton>
      <IconButton href="mailto:cristian08nc@gmail.com" label="Correo electrónico"><EmailIcon class={iconClass} aria-hidden="true"/></IconButton>
    </div>
    <span class="font-medium md:text-base xl:text-lg text-primary-50 text-center mt-4 md:mt-6 xl:mt-8 text-sm">{new Date().getFullYear()} Cristian Narváez - Hecho con cariño.</span>
  </div>
</Section>
