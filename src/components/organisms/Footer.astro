---
import Container from "../../templates/Container.astro";
import IconButton from "../atoms/IconButton.astro";
import Logo from "../atoms/Logo.astro";
import BehanceIcon from "../../assets/behance.svg";
import LinkedinIcon from "../../assets/linkedin.svg";
import EmailIcon from "../../assets/email.svg";
import { site } from "../../config/site";
import { localizePath, useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath("/", lang);
const iconClass = "size-5 fill-current";
---

<footer class="border-t border-line py-12">
  <Container class="flex flex-col items-center gap-8 md:flex-row md:justify-between">
    <div class="flex flex-col items-center gap-3 md:items-start">
      <a href={home} aria-label={t.a11y.home} class="text-fg">
        <Logo size="lg" />
      </a>
      <p class="text-sm text-subtle">{t.footer.tagline}</p>
    </div>

    <div class="flex gap-3">
      <IconButton href={site.linkedin} target="_blank" label="LinkedIn"><LinkedinIcon class={iconClass} aria-hidden="true" /></IconButton>
      <IconButton href={site.behance} target="_blank" label="Behance"><BehanceIcon class={iconClass} aria-hidden="true" /></IconButton>
      <IconButton href={`mailto:${site.email}`} label={site.email}><EmailIcon class={iconClass} aria-hidden="true" /></IconButton>
    </div>
  </Container>
  <Container>
    <p class="mt-8 text-center text-xs text-subtle md:text-left">© {new Date().getFullYear()} Cristian Narváez</p>
  </Container>
</footer>
