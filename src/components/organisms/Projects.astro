---
import Section from "../../templates/Section.astro";
import SectionHeading from "../molecules/SectionHeading.astro";
import Project from "../molecules/Project.astro";
import { getProjects } from "../../lib/projects";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [featured, ...rest] = await getProjects(lang);
---

<Section id="projects">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeading eyebrow={t.projects.eyebrow} lead={t.projects.lead}>{t.projects.title}</SectionHeading>

    <div class="grid gap-6 md:grid-cols-2">
      {featured && (
        <div class="md:col-span-2">
          <Project project={featured} lang={lang} featured />
        </div>
      )}
      {rest.map((project, i) => <Project project={project} lang={lang} delay={(i % 2) * 120} />)}
    </div>
  </div>
</Section>
