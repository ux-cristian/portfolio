---
import Section from "../../templates/Section.astro";
import SectionHeading from "../molecules/SectionHeading.astro";
import Project from "../molecules/Project.astro";
import ProjectIcon from "../../assets/palette.svg";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<Section id="projects" class="bg-[url('../assets/vectors/wireframe_vector.svg')] bg-cover bg-gray-100">
  <div class="flex flex-col w-full items-center gap-8 md:gap-14 xl:gap-16">
    <SectionHeading icon={ProjectIcon}>Proyectos</SectionHeading>
    {projects.map((project) => <Project project={project} />)}
  </div>
</Section>
