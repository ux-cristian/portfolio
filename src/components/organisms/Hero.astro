---
import { Image } from "astro:assets";
import Container from "../../templates/Container.astro";
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";
import portrait from "../../assets/cristian_photo_without_bg.webp";
import { localizePath, useTranslations, type Lang } from "../../i18n";
import { site } from "../../config/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath("/", lang);
const primaryHref = site.bookingUrl || `${home}#contact`;

const chipPositions = [
  "top-8 -left-3 lg:-left-10",
  "top-1/3 -right-3 lg:-right-8 [animation-delay:-2s]",
  "bottom-28 -left-4 lg:-left-14 [animation-delay:-4s]",
];
---

<section id="hero" class="relative pt-12 pb-20 md:pt-20 md:pb-28">
  <Container class="grid items-center gap-14 lg:grid-cols-[1.2fr_0.8fr] lg:gap-10">
    <div class="flex flex-col items-start gap-7">
      <span data-animate class="glass inline-flex items-center gap-2.5 rounded-full py-1.5 pr-4 pl-3 text-sm font-medium text-muted">
        <span class="relative flex size-2.5" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:animate-none"></span>
          <span class="relative inline-flex size-2.5 rounded-full bg-emerald-400"></span>
        </span>
        {t.hero.badge}
      </span>

      <h1 data-animate style="--reveal-delay: 80ms" class="font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-[1.08]">
        <span class="text-gradient">{t.hero.title}</span>
      </h1>

      <p data-animate style="--reveal-delay: 160ms" class="max-w-xl text-lg text-pretty text-muted md:text-xl">
        {t.hero.lead}
      </p>

      <div data-animate style="--reveal-delay: 240ms" class="flex flex-wrap gap-3">
        <Button href={primaryHref} size="lg" target={site.bookingUrl ? "_blank" : undefined}>
          {t.hero.primaryCta}
          <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover/btn:translate-x-1" />
        </Button>
        <Button href={`${home}#projects`} variant="glass" size="lg">{t.hero.secondaryCta}</Button>
      </div>

      <dl data-animate style="--reveal-delay: 320ms" class="mt-4 grid w-full max-w-xl grid-cols-3 gap-4 border-t border-line pt-6">
        {t.hero.stats.map(({ value, label }) => (
          <div class="flex flex-col gap-1">
            <dt class="text-xs leading-snug text-subtle md:text-sm">{label}</dt>
            <dd class="order-first text-2xl font-bold tracking-tight md:text-3xl">{value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Retrato con etiquetas flotantes. El marco no usa backdrop-filter y la tarjeta
         del nombre es hermana (no hija) del marco: Chrome deja de pintar la foto cuando
         hay backdrop-filter anidado dentro de un contenedor animado. -->
    <!-- Sin animación de entrada aquí: combinada con los efectos glass, Chrome a veces no pinta la foto -->
    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div
        class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] border border-[var(--glass-border)] bg-gradient-to-b from-royal-400/15 to-royal-600/30 shadow-[inset_0_1px_0_var(--glass-highlight),var(--glass-shadow)]"
      >
        <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_50%_100%,rgb(61_95_245/0.65),transparent_70%)]" aria-hidden="true"></div>
        <Image
          src={portrait}
          alt={t.hero.photoAlt}
          widths={[400, 640, 896]}
          sizes="(min-width: 1024px) 420px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-x-0 bottom-0 h-[94%] w-full object-contain object-bottom"
        />
      </div>

      <div class="absolute inset-x-4 bottom-4 rounded-2xl border border-[var(--glass-border)] bg-[color-mix(in_srgb,var(--surface)_82%,transparent)] px-4 py-3 shadow-[inset_0_1px_0_var(--glass-highlight)] backdrop-blur-xl">
        <p class="font-bold">Cristian Narváez</p>
        <p class="text-sm text-muted">{t.hero.role}</p>
      </div>

      {t.hero.chips.map((chip, i) => (
        <span
          aria-hidden="true"
          class:list={[
            "glass-strong absolute flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold whitespace-nowrap",
            "motion-safe:animate-[float_6s_ease-in-out_infinite]",
            chipPositions[i],
          ]}
        >
          <Icon name="sparkle" class="size-4 text-accent" />
          {chip}
        </span>
      ))}
    </div>
  </Container>
</section>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>
