---
import Section from "../../templates/Section.astro";
import SectionHeading from "../molecules/SectionHeading.astro";
import Experience from "../molecules/Experience.astro";
import Button from "../atoms/Button.astro";
import Tag from "../atoms/Tag.astro";
import Icon from "../atoms/Icon.astro";
import { experience } from "../../data/experience";
import { site } from "../../config/site";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="about">
  <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div class="flex flex-col gap-8">
      <SectionHeading eyebrow={t.about.eyebrow}>{t.about.title}</SectionHeading>

      <div data-reveal class="flex flex-col gap-4 text-lg leading-relaxed text-pretty text-muted">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div data-reveal class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold tracking-wide text-subtle uppercase">{t.about.skillsTitle}</h3>
        <ul class="flex flex-wrap gap-2">
          {t.about.skills.map((skill) => <li class="flex"><Tag>{skill}</Tag></li>)}
        </ul>
      </div>
    </div>

    <div data-reveal style="--reveal-delay: 120ms" class="glass flex h-fit flex-col gap-8 rounded-[2rem] p-7 md:p-9">
      <h3 class="text-xl font-bold tracking-tight">{t.about.experienceTitle}</h3>
      <ol>
        {experience.map((job) => (
          <Experience
            title={job.title[lang]}
            company={job.company}
            url={job.url}
            period={`${job.start[lang]} — ${job.end[lang]}`}
            description={job.description[lang]}
            newTabLabel={t.a11y.newTab}
          />
        ))}
      </ol>
      <Button href={site.cv} variant="glass" download>
        <Icon name="download" class="size-4" />
        {t.about.cv}
      </Button>
    </div>
  </div>
</Section>
