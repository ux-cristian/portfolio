---
import NavBar from "../molecules/NavBar.astro";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header id="site-header" class="group/header sticky top-0 z-40 pt-3 md:pt-4">
  <!-- En pantallas grandes la barra ocupa casi todo el ancho (máx. 1600px) -->
  <div class="mx-auto w-full max-w-6xl px-5 md:px-8 lg:max-w-[1600px] lg:px-6">
    <NavBar lang={lang} />
  </div>
</header>
