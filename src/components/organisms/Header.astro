---
import Container from "../../templates/Container.astro";
import NavBar from "../molecules/NavBar.astro";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header id="site-header" class="group/header sticky top-0 z-40 pt-3 md:pt-4">
  <Container>
    <NavBar lang={lang} />
  </Container>
</header>
