---
import Section from "../../templates/Section.astro";
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";
import Tag from "../atoms/Tag.astro";
import { site } from "../../config/site";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
  title?: string;
  lead?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { title = t.contact.title, lead = t.contact.lead } = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t.contact.emailSubject)}`;
---

<Section id="contact">
  <div data-reveal class="glass-strong relative overflow-hidden rounded-[2.5rem] px-6 py-16 text-center md:px-16 md:py-24">
    <div class="pointer-events-none absolute -top-40 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-[var(--glow)] blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-6">
      <Tag variant="accent">{t.contact.eyebrow}</Tag>
      <h2 class="font-display text-3xl font-semibold tracking-tight text-balance md:text-5xl md:leading-[1.08]">{title}</h2>
      <p class="text-lg text-pretty text-muted md:text-xl">{lead}</p>

      <div class="mt-2 flex flex-wrap justify-center gap-3">
        {site.bookingUrl && (
          <Button href={site.bookingUrl} target="_blank" size="lg">
            <Icon name="calendar" class="size-4" />
            {t.contact.book}
          </Button>
        )}
        <Button href={mailto} size="lg" variant={site.bookingUrl ? "glass" : "primary"}>
          <Icon name="mail" class="size-4" />
          {t.contact.email}
        </Button>
        <Button href={site.linkedin} target="_blank" size="lg" variant="glass">
          LinkedIn
          <Icon name="arrow-up-right" class="size-4" />
          <span class="sr-only">{t.a11y.newTab}</span>
        </Button>
      </div>

      <p class="text-sm text-subtle">
        {t.contact.or} <a href={mailto} class="font-medium text-accent hover:underline">{site.email}</a>
      </p>
    </div>
  </div>
</Section>
