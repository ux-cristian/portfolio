---
import OpenInNewIcon from '../../assets/icons/open_in_new.svg'
import Icon from "../../assets/business_center.svg";
import Section from "../../templates/Section.astro";
import SectionHeading from "../molecules/SectionHeading.astro";
import Experience from "../molecules/Experience.astro";
import Button from "../atoms/Button.astro";
import { works } from "../../data/works.js";
---

<Section id="work-experience" class="bg-gray-50">
  <div class="flex flex-col gap-6 md:gap-8">
    <SectionHeading icon={Icon} class="mb-4 md:mb-5 xl:mb-8">Experiencia laboral</SectionHeading>

    {works.map((work) => <Experience {...work} />)}

    <div class="flex justify-end mt-4 md:mt-6 xl:mt-8">
      <Button href="/cv_cristian_narvaez.pdf" target="_blank" type="outline">
        Ver CV <OpenInNewIcon class="size-[18px] md:size-5 xl:size-6 fill-primary-600" aria-hidden="true"/>
        <span class="sr-only">(se abre en otra pestaña)</span>
      </Button>
    </div>
  </div>
</Section>
