---
interface Props {
  variant?: "glass" | "accent";
  class?: string;
}

const { variant = "glass", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex h-fit w-fit items-center rounded-full px-3 py-1 text-xs font-semibold tracking-wide",
    variant === "glass" ? "glass text-muted" : "bg-accent-soft text-accent ring-1 ring-line",
    className,
  ]}
>
  <slot />
</span>
