---
// Logotipo tipográfico: el nombre en Instrument Serif cursiva.
interface Props {
  size?: "md" | "lg";
  class?: string;
}

const { size = "md", class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    "font-logo leading-none tracking-[-0.01em] whitespace-nowrap italic",
    size === "md" ? "text-[1.6rem] md:text-[1.75rem]" : "text-4xl",
    className,
  ]}
>
  Cristian Narváez<span class="not-italic opacity-50">.</span>
</span>
