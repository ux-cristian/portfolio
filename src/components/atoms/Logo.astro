---
import LogoHeader from "../../assets/vectors/logo_header.svg";
import LogoFooter from "../../assets/vectors/logo_footer.svg";

interface Props {
  type?: "header" | "footer";
  class?: string;
}

const { type = "header", class: className } = Astro.props;
---

{type === "header"
  ? <LogoHeader class:list={["h-4 w-auto md:h-5", className]} aria-hidden="true" />
  : <LogoFooter class:list={["h-10 w-auto", className]} aria-hidden="true" />}
