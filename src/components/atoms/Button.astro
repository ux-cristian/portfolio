---

interface Props {
  variant?: "primary" | "glass" | "ghost";
  size?: "md" | "lg";
  href?: string;
  target?: "_blank" | "_self";
  download?: boolean;
  class?: string;
}

const { variant = "primary", size = "md", href, target, download = false, class: className } = Astro.props;

const variants = {
  primary:
    "solid hover:brightness-110",
  glass: "glass text-fg hover:bg-white/10",
  ghost: "text-accent hover:text-accent-strong px-0!",
};

const sizes = {
  md: "h-11 px-5 text-sm",
  lg: "h-13 px-7 text-base",
};

const Element = href ? "a" : "button";
---

<Element
  href={href}
  target={href ? target : undefined}
  rel={href && target === "_blank" ? "noopener noreferrer" : undefined}
  download={href && download ? "" : undefined}
  type={!href ? "button" : undefined}
  class:list={[
    "group/btn inline-flex w-fit shrink-0 items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap",
    "transition-all duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 active:translate-y-0",
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</Element>
