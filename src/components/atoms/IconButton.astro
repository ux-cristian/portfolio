---
interface Props {
    href: string;
    label: string;
    target?: '_blank' | '_self';
}

const { href, label, target = '_self'} = Astro.props;
---

<a
    href={href}
    target={target}
    rel={target === '_blank' ? 'noopener noreferrer' : undefined}
    aria-label={label}
    title={label}
    class="flex p-3 rounded-full focus-visible:outline-2 focus-visible:outline-primary-50"
>
    <slot/>
</a>
